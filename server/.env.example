# ==============================================================================
# SyncNote Server Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in non-sensitive configuration for your environment.
# Copy .env.secrets.example to .env.secrets for sensitive credentials.

# General Application Server Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Central PostgreSQL Authentication Database Configuration (Supabase)
POSTGRES_HOST=aws-0-region.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres.your_project_ref:your_postgres_password@aws-0-region.pooler.supabase.com:5432/postgres

# Local SQLite & Storage Directories
SQLITE_PATH=./data/syncnote.db
NOTES_DIR=./data/notes

# Google OAuth Redirect Callbacks
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_DRIVE_CALLBACK_URL=http://localhost:5000/api/auth/google/drive/callback

# Sensitive Credentials References (Loaded from .env.secrets)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_SECRET=your_jwt_secret
COOKIE_SECRET=your_cookie_secret
